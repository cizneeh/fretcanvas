---
import { translate } from '../../i18n/config'
import { getAboutPath, getAlternatePath, getAppPath, getRouteLocale } from '../../i18n/routing'
import { SITE_NAME } from '../../libs/site'
import { LanguageSwitch } from './LanguageSwitch'

interface Props {
  pageKind: 'app' | 'about'
}

const { pageKind } = Astro.props
const locale = getRouteLocale(Astro.currentLocale)
const currentPath = Astro.url.pathname
const appPath = getAppPath(locale)
const aboutPath = getAboutPath(locale)
const alternatePath = getAlternatePath(locale, currentPath)
const aboutLabel = translate(locale, 'nav.about')
const appLabel = translate(locale, 'nav.app')
---

<header class="fixed inset-x-0 top-0 z-30 bg-[color:var(--md-sys-color-surface-container-low)]/42 backdrop-blur-md">
  <div class="mx-auto flex w-full max-w-[106rem] items-center justify-between gap-4 px-4 py-2 md:px-8">
    <a href={appPath} class="text-xl font-medium tracking-tight text-zinc-100/92 no-underline">
      {SITE_NAME}
    </a>

    <div class="flex items-center gap-3">
      {pageKind === 'about' && (
        <a
          href={appPath}
          class="m3-focus-ring text-sm text-[color:var(--md-sys-color-on-surface-variant)] no-underline transition-colors duration-150 hover:text-[color:var(--md-sys-color-on-surface)]"
        >
          {appLabel}
        </a>
      )}

      <a
        id="shell-about-link"
        href={aboutPath}
        aria-current={pageKind === 'about' ? 'page' : undefined}
        class="m3-focus-ring text-sm text-[color:var(--md-sys-color-on-surface-variant)] no-underline transition-colors duration-150 hover:text-[color:var(--md-sys-color-on-surface)] aria-[current=page]:text-[color:var(--md-sys-color-on-surface)]"
      >
        {aboutLabel}
      </a>

      <LanguageSwitch
        client:load
        alternatePath={alternatePath}
        initialLocale={locale}
      />
    </div>
  </div>
</header>
