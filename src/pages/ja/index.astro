---
import App from '../../App'
import { getRouteLocale } from '../../i18n/routing'
import BaseLayout from '../../layouts/BaseLayout.astro'

const locale = getRouteLocale(Astro.currentLocale)
---

<BaseLayout
  description="ギターなどの弦楽器の指板上のスケールやコードトーンを可視化できるツール。指板図を PNG / SVG で書き出し、動画作成などにも利用可能。"
  title="Fret Canvas"
>
  <App client:load initialLocale={locale} />
</BaseLayout>
