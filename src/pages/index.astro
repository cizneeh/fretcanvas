---
import App from '../App'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  aboutPath="/about"
  alternatePath="/ja"
  appPath="/"
  canonicalPath="/"
  currentPath="/"
  description="Fret Canvas is a guitar fretboard visualization tool for mapping scales, chord tones, tunings, and export clean fretboard diagrams for content creators."
  locale="en"
  pageKind="app"
  title="Fret Canvas"
>
  <App client:only="react">
    <div
      slot="fallback"
      aria-hidden="true"
      class="mx-auto flex w-full min-w-0 max-w-[106rem] flex-1 flex-col gap-6 pt-10"
    />
  </App>
</BaseLayout>
