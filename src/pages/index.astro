---
import App from '../App'
import { getRouteLocale } from '../i18n/routing'
import BaseLayout from '../layouts/BaseLayout.astro'

const locale = getRouteLocale(Astro.currentLocale)
---

<BaseLayout
  description="A guitar fretboard visualization tool for mapping scales or chord tones. You can also export fretboard diagrams as images."
  title="Fret Canvas"
>
  <App client:load initialLocale={locale} />
</BaseLayout>
